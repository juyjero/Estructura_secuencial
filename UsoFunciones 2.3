Algoritmo UsoFunciones
	Definir num, seno, coseno, tangente, rais, logaritmo_n, logaritmo10 Como Real 
	Imprimir ("ingrese un numero")
	Leer num
	seno=sen(num)
	coseno=cos(num)
	tangente=tan(num)
	rais=raiz(num)
	logaritmo10=  ln(num) / ln (10)
	logaritmo_n=ln(num)
	Imprimir  "Seno: ", seno
    Imprimir  "Coseno: ", coseno
    Imprimir  "Tangente: ", tangente
    Imprimir  "Raiz: ", rais
    Imprimir  "Ln: ", logaritmo_n
    Imprimir  "Log10: ", logaritmo10
	
FinAlgoritmo
